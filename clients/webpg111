<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lumina | Architectural Design</title>
    <!-- Premium Fonts: Playfair Display for headers, Lato for body -->
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
        /* --- LUMINA THEME (Ultra-Premium Light) --- */
        :root {
            --bg-color: #fcfbf9;
            --text-main: #1a1a1a;
            --text-light: #666666;
            --accent: #b89b5e; /* Muted Gold */
            --ad-bg: #f0eee9;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Lato', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.7;
            overflow-x: hidden;
            cursor: default;
        }

        h1, h2, h3, .brand {
            font-family: 'Playfair Display', serif;
            font-weight: 400;
        }

        a {
            text-decoration: none;
            color: var(--text-main);
        }

        /* --- NAVIGATION --- */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 2rem 5%;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 100;
            background: rgba(252, 251, 249, 0.9);
            backdrop-filter: blur(10px);
        }

        .brand {
            font-size: 1.5rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .nav-links {
            display: flex;
            gap: 3rem;
        }

        .nav-links a {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: color 0.3s ease;
        }

        .nav-links a:hover {
            color: var(--accent);
        }

        /* --- HERO SECTION --- */
        .hero {
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 0 10%;
            position: relative;
        }

        .hero h1 {
            font-size: clamp(3rem, 8vw, 7rem);
            line-height: 1.05;
            margin-bottom: 2rem;
            max-width: 1200px;
        }

        .hero p {
            font-size: 1.2rem;
            color: var(--text-light);
            max-width: 500px;
            margin-left: 2rem;
            border-left: 2px solid var(--accent);
            padding-left: 1.5rem;
        }

        /* --- THE AD-INTEGRATION DEMO --- */
        .ad-banner {
            background-color: var(--ad-bg);
            padding: 1rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid rgba(0,0,0,0.05);
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .ad-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-light);
        }

        .ad-content {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            color: var(--text-main);
        }

        /* --- PROJECT SHOWCASE --- */
        .projects {
            padding: 10rem 5%;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 5rem;
        }

        .section-header h2 {
            font-size: 3rem;
        }

        .project-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
        }

        .project-card {
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

        /* Moving the 2nd card down to create an asymmetrical, high-end layout */
        .project-card:nth-child(even) {
            margin-top: 8rem;
        }

        .project-image {
            width: 100%;
            height: 600px;
            background-color: #e5e5e5;
            position: relative;
            overflow: hidden;
            transition: transform 0.7s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        /* Fake Image Placeholders - using CSS gradients to look like modern art/architecture */
        .img-1 { background: linear-gradient(45deg, #d5d1c8, #e8e5df); }
        .img-2 { background: linear-gradient(45deg, #2a2a2a, #4a4a4a); }
        .img-3 { background: linear-gradient(45deg, #b89b5e, #d4af37); }
        .img-4 { background: linear-gradient(45deg, #8a938b, #a5b0a6); }

        .project-card:hover .project-image {
            transform: scale(0.98);
        }

        .project-info {
            padding-top: 1.5rem;
            display: flex;
            justify-content: space-between;
        }

        .project-title {
            font-size: 1.5rem;
            font-family: 'Playfair Display', serif;
        }

        .project-category {
            font-size: 0.85rem;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* --- FOOTER & CODOT BRANDING --- */
        footer {
            padding: 5rem 5%;
            background-color: #1a1a1a;
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .footer-brand {
            font-size: 2rem;
            font-family: 'Playfair Display', serif;
        }

        /* This is where you flex your agency */
        .codot-badge {
            background-color: #000;
            border: 1px solid #333;
            padding: 0.8rem 1.5rem;
            border-radius: 50px;
            font-family: 'Lato', sans-serif;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #888;
        }

        .codot-badge span {
            color: #00e5ff; /* Your agency cyan */
            font-weight: 700;
        }

        /* --- ANIMATION CLASSES --- */
        .reveal {
            opacity: 0;
            transform: translateY(50px);
            transition: all 1s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        @media (max-width: 768px) {
            .project-grid { grid-template-columns: 1fr; gap: 2rem; }
            .project-card:nth-child(even) { margin-top: 0; }
            .hero h1 { font-size: 3.5rem; }
            footer { flex-direction: column; gap: 2rem; text-align: center; }
            .nav-links { display: none; }
        }
    </style>
</head>
<body>

    <nav>
        <div class="brand">Lumina</div>
        <div class="nav-links">
            <a href="#">Studio</a>
            <a href="#">Projects</a>
            <a href="#">Journal</a>
            <a href="#">Contact</a>
        </div>
    </nav>

    <header class="hero">
        <h1 class="reveal">Designing the<br>future of space.</h1>
        <p class="reveal">Award-winning architectural design focused on sustainable, minimalist, and emotionally resonant environments.</p>
    </header>

    <!-- PREMIUM AD SPACE INTEGRATION -->
    <div class="ad-banner reveal">
        <span class="ad-label">Sponsored Highlight</span>
        <span class="ad-content">"Elevate your interior with bespoke Italian ceramics. Discover the new collection."</span>
        <a href="#" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid var(--text-main);">Explore</a>
    </div>

    <section class="projects">
        <div class="section-header reveal">
            <h2>Selected Works</h2>
            <a href="#" style="text-transform: uppercase; letter-spacing: 2px; font-size: 0.85rem; border-bottom: 1px solid var(--text-main);">View Archive</a>
        </div>

        <div class="project-grid">
            <div class="project-card reveal">
                <div class="project-image img-1"></div>
                <div class="project-info">
                    <span class="project-title">The Oslo Residence</span>
                    <span class="project-category">Residential</span>
                </div>
            </div>

            <div class="project-card reveal">
                <div class="project-image img-2"></div>
                <div class="project-info">
                    <span class="project-title">Apex Headquarters</span>
                    <span class="project-category">Commercial</span>
                </div>
            </div>

            <div class="project-card reveal">
                <div class="project-image img-3"></div>
                <div class="project-info">
                    <span class="project-title">Kyoto Retreat</span>
                    <span class="project-category">Hospitality</span>
                </div>
            </div>

            <div class="project-card reveal">
                <div class="project-image img-4"></div>
                <div class="project-info">
                    <span class="project-title">Vanguard Gallery</span>
                    <span class="project-category">Cultural</span>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <div class="footer-brand">Lumina</div>
        
        <!-- THE CODOT FLEX -->
        <a href="../index.html" class="codot-badge">
            Powered by <span>CODOT</span> Ad-Supported Engine
        </a>
    </footer>

    <!-- INTERSECTION OBSERVER FOR SMOOTH REVEALS -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const reveals = document.querySelectorAll(".reveal");

            const revealOnScroll = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("active");
                        // Optional: Stop observing once revealed
                        // observer.unobserve(entry.target); 
                    }
                });
            }, {
                threshold: 0.15, // Triggers when 15% of the element is visible
                rootMargin: "0px 0px -50px 0px" 
            });

            reveals.forEach(reveal => {
                revealOnScroll.observe(reveal);
            });
            
            // Trigger immediately for elements already in view on load
            setTimeout(() => {
                reveals.forEach(reveal => {
                    if (reveal.getBoundingClientRect().top < window.innerHeight) {
                        reveal.classList.add("active");
                    }
                });
            }, 100);
        });
    </script>
</body>
</html>
